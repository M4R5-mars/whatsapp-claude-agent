# 1. Copy this file to a file named ".env" in the same folder as server.js.
# 2. Fill in the values. NEVER send your .env by email or chat.

# A secret word you choose. You'll also enter it in Meta (Webhook > Verify token).
WHATSAPP_VERIFY_TOKEN=choose-a-long-secret-word

# Meta: App settings > Basic > App secret
META_APP_SECRET=

# Meta: permanent system user token (whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_TOKEN=

# Meta: WhatsApp > API Setup > Phone number ID (of the number you'll use)
WHATSAPP_PHONE_NUMBER_ID=

# Claude Console: Settings > API keys
ANTHROPIC_API_KEY=

# Allowed numbers, comma-separated, with country code (e.g. 351912345678,351923456789)
# Use * to accept any number (careful: anyone with your number can spend your credits).
ALLOWED_NUMBERS=

# Max replies per number per day (0 = no limit).
# If not set: 50 when ALLOWED_NUMBERS=*, no limit with a list of numbers.
# MAX_MESSAGES_PER_DAY=50

# Network: the tunnel connects to this address. Leave as is unless told otherwise.
HOST=127.0.0.1
PORT=3000

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
GRAPH_API_VERSION=v23.0
HISTORY_SIZE=12

# Optional: fixed messages sent to users (the AI's own replies follow the user's language)
# MSG_LIMIT=You've reached today's message limit. Please try again tomorrow.
# MSG_MEDIA_ERROR=I couldn't open that file. Could you try sending it again?
# MSG_AI_ERROR=I'm having a technical problem right now. Please try again in a moment.
# MSG_EMPTY=Sorry, I couldn't come up with a reply. Could you rephrase?
